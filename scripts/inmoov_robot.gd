## InMoov i2: model from inmoov.glb + kinematics/collisions from inmoov_robot.json.
## Source of truth is the URDF (urdf_export_i2/inmoov_i2.urdf); both files are generated by
## an external export script (not part of this repository).
##
## Usage:
##   robot.set_joint("left_elbow_x_joint", 0.5)      # radians, respecting limits
##   robot.set_pose({"torso_y_joint": 0.1, ...})
##   var pairs = await robot.check_pose({...})        # pre-check a pose
##   robot.self_collision_changed.connect(func(pairs): ...)
class_name InmoovRobot
extends Node3D

signal self_collision_changed(pairs: Array)
signal pose_changed

@export var glb_scene: PackedScene = preload("res://robot/inmoov.glb")
@export_file("*.json") var robot_json := "res://robot/inmoov_robot.json"
## Highlight links involved in a self-collision.
@export var highlight_collisions := true
@export var highlight_color := Color(1.0, 0.15, 0.1, 0.55)

var joints := {}            ## name -> Dictionary from JSON (+ node, axis_v)
var positions := {}         ## name -> angle (rad), including mimic joints
var link_nodes := {}        ## link -> Node3D (the joint rotation is written to it)
var link_areas := {}        ## link -> Area3D
var colliding_pairs: Array = []   ## [[linkA, linkB], ...] — current self-collisions
var root_link := ""
var controllable: Array[String] = []   ## revolute joints without mimic (what the user controls)

var _model: Node3D
var _mimic_followers := {}  ## leading joint -> [followers]
var _area_link := {}        ## Area3D -> link
var _disabled := {}         ## "a|b" -> true (from SRDF)
var _debug_meshes: Array[MeshInstance3D] = []
var _hl_mat: StandardMaterial3D
var _highlighted := {}
var _sel_mat: StandardMaterial3D
var _selected := {}          ## link -> true (click selection, blue highlight)
var _pick_tm := {}           ## MeshInstance3D -> TriangleMesh (cache for pick_link)
var _pick_meshes: Array = [] ## [[link, MeshInstance3D], ...]
var _joint_of_child := {}    ## link -> name of the joint that moves it


func _ready() -> void:
	_model = glb_scene.instantiate()
	add_child(_model)
	var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(robot_json))
	root_link = data.root_link
	link_nodes[root_link] = _model.find_child(root_link, true, false)
	for j: Dictionary in data.joints:
		var n := _model.find_child(j.child, true, false) as Node3D
		if n == null:
			push_error("InmoovRobot: no link node %s in glb" % j.child)
			continue
		j["node"] = n
		j["axis_v"] = Vector3(j.axis[0], j.axis[1], j.axis[2]).normalized()
		joints[j.name] = j
		positions[j.name] = 0.0
		link_nodes[j.child] = n
		_joint_of_child[j.child] = j.name
		if j.has("mimic"):
			_mimic_followers.get_or_add(j.mimic.joint, []).append(j.name)
		elif j.type == "revolute":
			controllable.append(j.name)
	for p: Array in data.disabled_collision_pairs:
		_disabled[_key(p[0], p[1])] = true
	_build_collisions(data.collisions)
	_hl_mat = StandardMaterial3D.new()
	_hl_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	_hl_mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	_hl_mat.albedo_color = highlight_color
	_sel_mat = StandardMaterial3D.new()
	_sel_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	_sel_mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	_sel_mat.albedo_color = Color(0.2, 0.55, 1.0, 0.5)


# ---------------------------------------------------------------- joints

func get_limits(joint: String) -> Vector2:
	var l: Dictionary = joints[joint].get("limit", {})
	return Vector2(l.get("lower", -PI), l.get("upper", PI))


## Set a joint angle (rad). Limits are applied if clamp_to_limits.
## For mimic joints the call is ignored — they follow the leader.
func set_joint(joint: String, angle: float, clamp_to_limits := true) -> void:
	if not joints.has(joint) or joints[joint].has("mimic"):
		return
	if clamp_to_limits:
		var lim := get_limits(joint)
		angle = clampf(angle, lim.x, lim.y)
	_apply(joint, angle)
	pose_changed.emit()


func set_pose(pose: Dictionary, clamp_to_limits := true) -> void:
	for k in pose:
		if joints.has(k) and not joints[k].has("mimic"):
			var a: float = pose[k]
			if clamp_to_limits:
				var lim := get_limits(k)
				a = clampf(a, lim.x, lim.y)
			_apply(k, a)
	pose_changed.emit()


func get_pose() -> Dictionary:
	var p := {}
	for k in controllable:
		p[k] = positions[k]
	return p


func reset_pose() -> void:
	var p := {}
	for k in controllable:
		p[k] = 0.0
	set_pose(p)


func _apply(joint: String, angle: float) -> void:
	var j: Dictionary = joints[joint]
	positions[joint] = angle
	if j.type == "revolute" or j.type == "continuous":
		(j.node as Node3D).quaternion = Quaternion(j.axis_v, angle)
	elif j.type == "prismatic":
		(j.node as Node3D).position = j.axis_v * angle
	for f: String in _mimic_followers.get(joint, []):
		var m: Dictionary = joints[f].mimic
		_apply(f, angle * m.multiplier + m.offset)


# ---------------------------------------------------------------- collisions

static func _key(a: String, b: String) -> String:
	return a + "|" + b if a < b else b + "|" + a


static func _urdf_basis(rpy: Array) -> Basis:
	# URDF: R = Rz(yaw) * Ry(pitch) * Rx(roll)
	return Basis(Vector3.BACK, rpy[2]) * Basis(Vector3.UP, rpy[1]) * Basis(Vector3.RIGHT, rpy[0])


func _build_collisions(colls: Dictionary) -> void:
	for link: String in colls:
		var parent: Node3D = link_nodes.get(link)
		if parent == null:
			continue
		var area := Area3D.new()
		area.name = link + "__collision"
		area.monitoring = true
		area.monitorable = true
		for c: Dictionary in colls[link]:
			var cs := CollisionShape3D.new()
			var t := Transform3D(_urdf_basis(c.origin_rpy), Vector3(c.origin_xyz[0], c.origin_xyz[1], c.origin_xyz[2]))
			match c.type:
				"box":
					var s := BoxShape3D.new()
					s.size = Vector3(c.size[0], c.size[1], c.size[2])
					cs.shape = s
				"cylinder":
					var s := CylinderShape3D.new()
					s.radius = c.radius
					s.height = c.length
					cs.shape = s
					t.basis = t.basis * Basis(Vector3.RIGHT, PI / 2)  # Godot Y axis -> URDF Z axis
				"sphere":
					var s := SphereShape3D.new()
					s.radius = c.radius
					cs.shape = s
				"convex":
					var s := ConvexPolygonShape3D.new()
					var pts := PackedVector3Array()
					for p: Array in c.points:
						pts.append(Vector3(p[0], p[1], p[2]))
					s.points = pts
					cs.shape = s
				_:
					continue
			cs.transform = t
			area.add_child(cs)
			var dm := MeshInstance3D.new()
			dm.mesh = cs.shape.get_debug_mesh()
			dm.visible = false
			var mat := StandardMaterial3D.new()
			mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
			mat.albedo_color = Color(0.1, 0.6, 1.0)
			dm.material_override = mat
			cs.add_child(dm)
			_debug_meshes.append(dm)
		parent.add_child(area)
		link_areas[link] = area
		_area_link[area] = link


func set_collision_shapes_visible(v: bool) -> void:
	for m in _debug_meshes:
		m.visible = v


## Current self-collision pairs (excluding SRDF-disabled pairs).
func compute_colliding_pairs() -> Array:
	var seen := {}
	var out: Array = []
	for link: String in link_areas:
		for other: Area3D in (link_areas[link] as Area3D).get_overlapping_areas():
			var ol: String = _area_link.get(other, "")
			if ol == "" or ol == link:
				continue
			var k := _key(link, ol)
			if _disabled.has(k) or seen.has(k):
				continue
			seen[k] = true
			out.append(k.split("|"))
	out.sort_custom(func(a, b): return a[0] + a[1] < b[0] + b[1])
	return out


func _physics_process(_dt: float) -> void:
	var pairs := compute_colliding_pairs()
	if pairs != colliding_pairs:
		colliding_pairs = pairs
		if highlight_collisions:
			_update_highlight()
		self_collision_changed.emit(pairs)


## Check a pose without “showing” it to the user: apply, wait for a physics step,
## return the colliding pairs and (if restore) return to the previous pose.
func check_pose(pose: Dictionary, restore := true) -> Array:
	var old := get_pose()
	set_pose(pose)
	await get_tree().physics_frame
	await get_tree().physics_frame
	var pairs := compute_colliding_pairs()
	if restore:
		set_pose(old)
	return pairs


func _update_highlight() -> void:
	var now := {}
	for p: Array in colliding_pairs:
		now[p[0]] = true
		now[p[1]] = true
	var touched := {}
	for l in _highlighted.keys() + now.keys():
		touched[l] = true
	_highlighted = now
	for l in touched:
		_refresh_overlay(l)


## Red (self-collision) takes priority over blue (click selection).
func _refresh_overlay(link: String) -> void:
	var n: Node3D = link_nodes.get(link)
	if n == null:
		return
	var mat: Material = null
	if _highlighted.has(link):
		mat = _hl_mat
	elif _selected.has(link):
		mat = _sel_mat
	for ch in n.get_children():
		if ch is MeshInstance3D and String(ch.name).begins_with(link + "__"):
			(ch as MeshInstance3D).material_overlay = mat


# ---------------------------------------------------------------- pick a part by click

## Highlight links in blue (click selection). An empty array clears the highlight.
func set_selected_links(links: Array) -> void:
	var old := _selected.keys()
	_selected.clear()
	for l in links:
		_selected[l] = true
	for l in old + _selected.keys():
		_refresh_overlay(l)


## Links along a ray (world coordinates): [[distance, link], ...] ascending, one per link (the nearest)
## hit. Exact triangle test (the BVH is built lazily, only for meshes whose AABB the ray crossed).
func pick_links(from: Vector3, dir: Vector3) -> Array:
	if _pick_meshes.is_empty():
		for link: String in link_nodes:
			for ch in (link_nodes[link] as Node3D).get_children():
				if ch is MeshInstance3D and String(ch.name).begins_with(link + "__"):
					_pick_meshes.append([link, ch])
	var best := {}
	for e: Array in _pick_meshes:
		var mi: MeshInstance3D = e[1]
		if not mi.is_visible_in_tree() or mi.mesh == null:
			continue
		var inv := mi.global_transform.affine_inverse()
		var lo := inv * from
		var ld := (inv.basis * dir).normalized()
		if mi.get_aabb().intersects_ray(lo, ld) == null:
			continue
		var tm: TriangleMesh = _pick_tm.get(mi)
		if tm == null:
			tm = mi.mesh.generate_triangle_mesh()
			_pick_tm[mi] = tm
		if tm == null:
			continue
		var hit: Dictionary = tm.intersect_ray(lo, ld)
		if hit.is_empty():
			continue
		var d := from.distance_to(mi.global_transform * (hit.position as Vector3))
		if d < best.get(e[0], INF):
			best[e[0]] = d
	var out: Array = []
	for l in best:
		out.append([best[l], l])
	out.sort_custom(func(a, b): return a[0] < b[0])
	return out


## Nearest link under the ray, "" — nothing.
func pick_link(from: Vector3, dir: Vector3) -> String:
	var h := pick_links(from, dir)
	return "" if h.is_empty() else h[0][1]


## The joint that moves the link (fixed joints are returned too).
func joint_of_link(link: String) -> String:
	return _joint_of_child.get(link, "")


func parent_link_of_joint(joint: String) -> String:
	return joints[joint].parent


## Leader joint: for a mimic follower — its leader, otherwise itself.
func leader_of(joint: String) -> String:
	var j: Dictionary = joints[joint]
	return j.mimic.joint if j.has("mimic") else joint


## A joint + all its mimic followers (recursive).
func joint_family(joint: String) -> Array:
	var out := [joint]
	for f: String in _mimic_followers.get(joint, []):
		out.append_array(joint_family(f))
	return out
